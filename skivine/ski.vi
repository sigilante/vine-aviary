
/// The SKI calculus on interaction nets:
///
///     S x y z -> x z (y z)        K x y -> x        I x -> x
///
/// A `Term` is a value: a combinator that still lacks arguments. Application
/// is the function `apply`; a term with a redex is never built, only evaluated.

pub enum* Term {
  S(),
  S1(Term),
  S2(Term, Term),
  K(),
  K1(Term),
  I(),
}

pub mod Term {
  /// `f x`. Matches on the function only, so `x` is passed on unevaluated.
  /// `S x y` forks its argument and `K x` drops its argument.
  pub fn apply(f: Term, x: Term) -> Term {
    match f {
      Term::S() { Term::S1(x) }
      Term::S1(a) { Term::S2(a, x) }
      Term::S2(a, b) { apply(apply(a, x), apply(b, x)) }
      Term::K() { Term::K1(x) }
      Term::K1(a) { a }
      Term::I() { x }
    }
  }

  /// Evaluates a term written in prefix form: `S`, `K` and `I` are the atoms
  /// and a backtick applies the next two terms, so `` ``SKK `` is `S K K`.
  /// Any other character, or the end of the input, reads as `I`.
  pub fn eval(src: String) -> Term {
    let chars = src as List[Char];
    eval_from(&chars)
  }

  fn eval_from(&chars: &List[Char]) -> Term {
    let c = chars.pop_front().or_use('I');
    when {
      c == '`' {
        let f = eval_from(&chars);
        let x = eval_from(&chars);
        apply(f, x)
      }
      c == 'S' { Term::S() }
      c == 'K' { Term::K() }
      _ { Term::I() }
    }
  }

  /// The term in prefix form.
  pub fn .prefix(self: Term) -> String {
    let out = [];
    self.write(&out);
    out as String
  }

  fn .write(self: Term, &out: &List[Char]) {
    match self {
      Term::S() {
        out.push_back('S');
      }
      Term::S1(x) {
        out ++= ['`', 'S'];
        x.write(&out);
      }
      Term::S2(x, y) {
        out ++= ['`', '`', 'S'];
        x.write(&out);
        y.write(&out);
      }
      Term::K() {
        out.push_back('K');
      }
      Term::K1(x) {
        out ++= ['`', 'K'];
        x.write(&out);
      }
      Term::I() {
        out.push_back('I');
      }
    }
  }

  /// The number of atoms in the term.
  pub fn .size(self: Term) -> N32 {
    match self {
      Term::S1(x) { 1 + x.size() }
      Term::S2(x, y) { 1 + x.size() + y.size() }
      Term::K1(x) { 1 + x.size() }
      _ { 1 }
    }
  }
}
