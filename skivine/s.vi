
/// The pure S calculus, `S x y z -> x z (y z)`, on interaction nets.
///
/// A `Term` is a value: `S`, `S x`, or `S x y`. Application is the function
/// `apply`; a term with a redex is never built, only evaluated.

pub enum* Term {
  S(),
  S1(Term),
  S2(Term, Term),
}

pub mod Term {
  /// `f x`. Matches on the function only; `x` is passed on unevaluated, and is
  /// forked in the `S x y z` case.
  pub fn apply(f: Term, x: Term) -> Term {
    match f {
      Term::S() { Term::S1(x) }
      Term::S1(a) { Term::S2(a, x) }
      Term::S2(a, b) { apply(apply(a, x), apply(b, x)) }
    }
  }

  /// Evaluates a term written in prefix form: `S` is the atom and a backtick
  /// applies the next two terms, so `` ``SSS `` is `S S S`.
  pub fn eval(src: String) -> Term {
    let chars = src as List[Char];
    eval_from(&chars)
  }

  fn eval_from(&chars: &List[Char]) -> Term {
    if chars.pop_front().or_use('S') == '`' {
      let f = eval_from(&chars);
      let x = eval_from(&chars);
      apply(f, x)
    } else {
      Term::S()
    }
  }

  /// The term in prefix form.
  pub fn .prefix(self: Term) -> String {
    let out = [];
    self.write(&out);
    out as String
  }

  fn .write(self: Term, &out: &List[Char]) {
    match self {
      Term::S() {
        out.push_back('S');
      }
      Term::S1(x) {
        out ++= ['`', 'S'];
        x.write(&out);
      }
      Term::S2(x, y) {
        out ++= ['`', '`', 'S'];
        x.write(&out);
        y.write(&out);
      }
    }
  }

  /// The number of `S` atoms in the term.
  pub fn .size(self: Term) -> N32 {
    match self {
      Term::S() { 1 }
      Term::S1(x) { 1 + x.size() }
      Term::S2(x, y) { 1 + x.size() + y.size() }
    }
  }
}
