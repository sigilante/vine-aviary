  /// The number of birds in the term.
  pub fn .size(self: Term) -> N32 {
    match self {
      Term::B_1(x0) { 1 + x0.size() }
      Term::B_2(x0, x1) { 1 + x0.size() + x1.size() }
      Term::B1_1(x0) { 1 + x0.size() }
      Term::B1_2(x0, x1) { 1 + x0.size() + x1.size() }
      Term::B1_3(x0, x1, x2) { 1 + x0.size() + x1.size() + x2.size() }
      Term::B2_1(x0) { 1 + x0.size() }
      Term::B2_2(x0, x1) { 1 + x0.size() + x1.size() }
      Term::B2_3(x0, x1, x2) { 1 + x0.size() + x1.size() + x2.size() }
      Term::B2_4(x0, x1, x2, x3) { 1 + x0.size() + x1.size() + x2.size() + x3.size() }
