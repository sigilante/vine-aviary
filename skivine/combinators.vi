        Term::B3_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::C_1(x0) { x0.drop(); }
        Term::C_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Cs_1(x0) { x0.drop(); }
        Term::Cs_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Cs_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Css_1(x0) { x0.drop(); }
        Term::Css_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Css_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Css_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::D_1(x0) { x0.drop(); }
        Term::D_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::D_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::D1_1(x0) { x0.drop(); }
        Term::D1_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::D1_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::D1_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::D2_1(x0) { x0.drop(); }
        Term::D2_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::D2_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::D2_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::E_1(x0) { x0.drop(); }
        Term::E_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::E_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::E_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::Eh_1(x0) { x0.drop(); }
        Term::Eh_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Eh_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Eh_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::Eh_5(x0, x1, x2, x3, x4) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); x4.drop(); }
        Term::Eh_6(x0, x1, x2, x3, x4, x5) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); x4.drop(); x5.drop(); }
        Term::F_1(x0) { x0.drop(); }
        Term::F_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Fs_1(x0) { x0.drop(); }
        Term::Fs_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Fs_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Fss_1(x0) { x0.drop(); }
        Term::Fss_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Fss_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Fss_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::G_1(x0) { x0.drop(); }
        Term::G_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::G_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::H_1(x0) { x0.drop(); }
        Term::H_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Is_1(x0) { x0.drop(); }
        Term::Iss_1(x0) { x0.drop(); }
        Term::Iss_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::J_1(x0) { x0.drop(); }
        Term::J_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::J_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::K_1(x0) { x0.drop(); }
        Term::Ki_1(x0) { x0.drop(); }
        Term::KM_1(x0) { x0.drop(); }
        Term::KMp_1(x0) { x0.drop(); }
        Term::L_1(x0) { x0.drop(); }
        Term::M2_1(x0) { x0.drop(); }
        Term::O_1(x0) { x0.drop(); }
        Term::Phi_1(x0) { x0.drop(); }
        Term::Phi_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Phi_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Psi_1(x0) { x0.drop(); }
        Term::Psi_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Psi_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Q_1(x0) { x0.drop(); }
        Term::Q_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Q1_1(x0) { x0.drop(); }
        Term::Q1_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Q2_1(x0) { x0.drop(); }
        Term::Q2_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Q3_1(x0) { x0.drop(); }
        Term::Q3_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Q4_1(x0) { x0.drop(); }
        Term::Q4_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::R_1(x0) { x0.drop(); }
        Term::R_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Rs_1(x0) { x0.drop(); }
        Term::Rs_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Rs_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Rss_1(x0) { x0.drop(); }
        Term::Rss_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Rss_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Rss_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::S_1(x0) { x0.drop(); }
        Term::S_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::T_1(x0) { x0.drop(); }
        Term::U_1(x0) { x0.drop(); }
        Term::V_1(x0) { x0.drop(); }
        Term::V_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Vs_1(x0) { x0.drop(); }
        Term::Vs_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Vs_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Vss_1(x0) { x0.drop(); }
        Term::Vss_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Vss_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Vss_4(x0, x1, x2, x3) { x0.drop(); x1.drop(); x2.drop(); x3.drop(); }
        Term::W_1(x0) { x0.drop(); }
        Term::Ws_1(x0) { x0.drop(); }
        Term::Ws_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Wss_1(x0) { x0.drop(); }
        Term::Wss_2(x0, x1) { x0.drop(); x1.drop(); }
        Term::Wss_3(x0, x1, x2) { x0.drop(); x1.drop(); x2.drop(); }
        Term::Wp_1(x0) { x0.drop(); }
        _ {}
      }
    }
  }

  /// `f x`. Matches on the function only, so `x` is passed on unevaluated.
  pub fn apply(f: Term, x: Term) -> Term {
    match f {
      Term::B_0() { Term::B_1(x) }
      Term::B_1(a) { Term::B_2(a, x) }
      Term::B_2(a, b) { apply(a, apply(b, x)) }
      Term::B1_0() { Term::B1_1(x) }
      Term::B1_1(a) { Term::B1_2(a, x) }
      Term::B1_2(a, b) { Term::B1_3(a, b, x) }
      Term::B1_3(a, b, c) { apply(a, apply(apply(b, c), x)) }
      Term::B2_0() { Term::B2_1(x) }
      Term::B2_1(a) { Term::B2_2(a, x) }
      Term::B2_2(a, b) { Term::B2_3(a, b, x) }
      Term::B2_3(a, b, c) { Term::B2_4(a, b, c, x) }
      Term::B2_4(a, b, c, d) { apply(a, apply(apply(apply(b, c), d), x)) }
      Term::B3_0() { Term::B3_1(x) }
      Term::B3_1(a) { Term::B3_2(a, x) }
      Term::B3_2(a, b) { Term::B3_3(a, b, x) }
      Term::B3_3(a, b, c) { apply(a, apply(b, apply(c, x))) }
      Term::C_0() { Term::C_1(x) }
      Term::C_1(a) { Term::C_2(a, x) }
      Term::C_2(a, b) { apply(apply(a, x), b) }
      Term::Cs_0() { Term::Cs_1(x) }
      Term::Cs_1(a) { Term::Cs_2(a, x) }
      Term::Cs_2(a, b) { Term::Cs_3(a, b, x) }
      Term::Cs_3(a, b, c) { apply(apply(apply(a, b), x), c) }
      Term::Css_0() { Term::Css_1(x) }
      Term::Css_1(a) { Term::Css_2(a, x) }
      Term::Css_2(a, b) { Term::Css_3(a, b, x) }
      Term::Css_3(a, b, c) { Term::Css_4(a, b, c, x) }
      Term::Css_4(a, b, c, d) { apply(apply(apply(apply(a, b), c), x), d) }
      Term::D_0() { Term::D_1(x) }
      Term::D_1(a) { Term::D_2(a, x) }
      Term::D_2(a, b) { Term::D_3(a, b, x) }
      Term::D_3(a, b, c) { apply(apply(a, b), apply(c, x)) }
      Term::D1_0() { Term::D1_1(x) }
      Term::D1_1(a) { Term::D1_2(a, x) }
      Term::D1_2(a, b) { Term::D1_3(a, b, x) }
      Term::D1_3(a, b, c) { Term::D1_4(a, b, c, x) }
      Term::D1_4(a, b, c, d) { apply(apply(apply(a, b), c), apply(d, x)) }
      Term::D2_0() { Term::D2_1(x) }
      Term::D2_1(a) { Term::D2_2(a, x) }
      Term::D2_2(a, b) { Term::D2_3(a, b, x) }
      Term::D2_3(a, b, c) { Term::D2_4(a, b, c, x) }
      Term::D2_4(a, b, c, d) { apply(apply(a, apply(b, c)), apply(d, x)) }
      Term::E_0() { Term::E_1(x) }
      Term::E_1(a) { Term::E_2(a, x) }
      Term::E_2(a, b) { Term::E_3(a, b, x) }
      Term::E_3(a, b, c) { Term::E_4(a, b, c, x) }
      Term::E_4(a, b, c, d) { apply(apply(a, b), apply(apply(c, d), x)) }
      Term::Eh_0() { Term::Eh_1(x) }
      Term::Eh_1(a) { Term::Eh_2(a, x) }
      Term::Eh_2(a, b) { Term::Eh_3(a, b, x) }
      Term::Eh_3(a, b, c) { Term::Eh_4(a, b, c, x) }
      Term::Eh_4(a, b, c, d) { Term::Eh_5(a, b, c, d, x) }
      Term::Eh_5(a, b, c, d, e) { Term::Eh_6(a, b, c, d, e, x) }
      Term::Eh_6(a, b, c, d, e, f) { apply(apply(a, apply(apply(b, c), d)), apply(apply(e, f), x)) }
      Term::F_0() { Term::F_1(x) }
      Term::F_1(a) { Term::F_2(a, x) }
      Term::F_2(a, b) { apply(apply(x, b), a) }
      Term::Fs_0() { Term::Fs_1(x) }
      Term::Fs_1(a) { Term::Fs_2(a, x) }
      Term::Fs_2(a, b) { Term::Fs_3(a, b, x) }
      Term::Fs_3(a, b, c) { apply(apply(apply(a, x), c), b) }
      Term::Fss_0() { Term::Fss_1(x) }
      Term::Fss_1(a) { Term::Fss_2(a, x) }
      Term::Fss_2(a, b) { Term::Fss_3(a, b, x) }
      Term::Fss_3(a, b, c) { Term::Fss_4(a, b, c, x) }
      Term::Fss_4(a, b, c, d) { apply(apply(apply(apply(a, b), x), d), c) }
      Term::G_0() { Term::G_1(x) }
      Term::G_1(a) { Term::G_2(a, x) }
      Term::G_2(a, b) { Term::G_3(a, b, x) }
      Term::G_3(a, b, c) { apply(apply(a, x), apply(b, c)) }
      Term::H_0() { Term::H_1(x) }
      Term::H_1(a) { Term::H_2(a, x) }
      Term::H_2(a, b) { apply(apply(apply(a, b), x), b) }
      Term::I_0() { x }
      Term::Is_0() { Term::Is_1(x) }
      Term::Is_1(a) { apply(a, x) }
      Term::Iss_0() { Term::Iss_1(x) }
      Term::Iss_1(a) { Term::Iss_2(a, x) }
      Term::Iss_2(a, b) { apply(apply(a, b), x) }
      Term::J_0() { Term::J_1(x) }
      Term::J_1(a) { Term::J_2(a, x) }
      Term::J_2(a, b) { Term::J_3(a, b, x) }
      Term::J_3(a, b, c) { apply(apply(a, b), apply(apply(a, x), c)) }
      Term::K_0() { Term::K_1(x) }
      Term::K_1(a) { a }
      Term::Ki_0() { Term::Ki_1(x) }
      Term::Ki_1(_) { x }
      Term::KM_0() { Term::KM_1(x) }
      Term::KM_1(_) { apply(x, x) }
      Term::KMp_0() { Term::KMp_1(x) }
      Term::KMp_1(a) { apply(a, a) }
      Term::L_0() { Term::L_1(x) }
      Term::L_1(a) { apply(a, apply(x, x)) }
      Term::M_0() { apply(x, x) }
      Term::M2_0() { Term::M2_1(x) }
      Term::M2_1(a) { apply(apply(a, x), apply(a, x)) }
      Term::O_0() { Term::O_1(x) }
      Term::O_1(a) { apply(x, apply(a, x)) }
      Term::Phi_0() { Term::Phi_1(x) }
      Term::Phi_1(a) { Term::Phi_2(a, x) }
      Term::Phi_2(a, b) { Term::Phi_3(a, b, x) }
      Term::Phi_3(a, b, c) { apply(apply(a, apply(b, x)), apply(c, x)) }
      Term::Psi_0() { Term::Psi_1(x) }
      Term::Psi_1(a) { Term::Psi_2(a, x) }
      Term::Psi_2(a, b) { Term::Psi_3(a, b, x) }
      Term::Psi_3(a, b, c) { apply(apply(a, apply(b, c)), apply(b, x)) }
      Term::Q_0() { Term::Q_1(x) }
      Term::Q_1(a) { Term::Q_2(a, x) }
      Term::Q_2(a, b) { apply(b, apply(a, x)) }
      Term::Q1_0() { Term::Q1_1(x) }
      Term::Q1_1(a) { Term::Q1_2(a, x) }
      Term::Q1_2(a, b) { apply(a, apply(x, b)) }
      Term::Q2_0() { Term::Q2_1(x) }
      Term::Q2_1(a) { Term::Q2_2(a, x) }
      Term::Q2_2(a, b) { apply(b, apply(x, a)) }
      Term::Q3_0() { Term::Q3_1(x) }
      Term::Q3_1(a) { Term::Q3_2(a, x) }
      Term::Q3_2(a, b) { apply(x, apply(a, b)) }
      Term::Q4_0() { Term::Q4_1(x) }
      Term::Q4_1(a) { Term::Q4_2(a, x) }
      Term::Q4_2(a, b) { apply(x, apply(b, a)) }
      Term::R_0() { Term::R_1(x) }
      Term::R_1(a) { Term::R_2(a, x) }
      Term::R_2(a, b) { apply(apply(b, x), a) }
      Term::Rs_0() { Term::Rs_1(x) }
      Term::Rs_1(a) { Term::Rs_2(a, x) }
      Term::Rs_2(a, b) { Term::Rs_3(a, b, x) }
      Term::Rs_3(a, b, c) { apply(apply(apply(a, c), x), b) }
      Term::Rss_0() { Term::Rss_1(x) }
      Term::Rss_1(a) { Term::Rss_2(a, x) }
      Term::Rss_2(a, b) { Term::Rss_3(a, b, x) }
      Term::Rss_3(a, b, c) { Term::Rss_4(a, b, c, x) }
      Term::Rss_4(a, b, c, d) { apply(apply(apply(apply(a, b), d), x), c) }
      Term::S_0() { Term::S_1(x) }
      Term::S_1(a) { Term::S_2(a, x) }
      Term::S_2(a, b) { apply(apply(a, x), apply(b, x)) }
      Term::T_0() { Term::T_1(x) }
      Term::T_1(a) { apply(x, a) }
      Term::U_0() { Term::U_1(x) }
      Term::U_1(a) { apply(x, apply(apply(a, a), x)) }
      Term::V_0() { Term::V_1(x) }
      Term::V_1(a) { Term::V_2(a, x) }
      Term::V_2(a, b) { apply(apply(x, a), b) }
      Term::Vs_0() { Term::Vs_1(x) }
      Term::Vs_1(a) { Term::Vs_2(a, x) }
      Term::Vs_2(a, b) { Term::Vs_3(a, b, x) }
      Term::Vs_3(a, b, c) { apply(apply(apply(a, x), b), c) }
      Term::Vss_0() { Term::Vss_1(x) }
      Term::Vss_1(a) { Term::Vss_2(a, x) }
      Term::Vss_2(a, b) { Term::Vss_3(a, b, x) }
      Term::Vss_3(a, b, c) { Term::Vss_4(a, b, c, x) }
      Term::Vss_4(a, b, c, d) { apply(apply(apply(apply(a, b), x), c), d) }
      Term::W_0() { Term::W_1(x) }
      Term::W_1(a) { apply(apply(a, x), x) }
      Term::Ws_0() { Term::Ws_1(x) }
      Term::Ws_1(a) { Term::Ws_2(a, x) }
      Term::Ws_2(a, b) { apply(apply(apply(a, b), x), x) }
      Term::Wss_0() { Term::Wss_1(x) }
      Term::Wss_1(a) { Term::Wss_2(a, x) }
      Term::Wss_2(a, b) { Term::Wss_3(a, b, x) }
      Term::Wss_3(a, b, c) { apply(apply(apply(apply(a, b), c), x), x) }
      Term::Wp_0() { Term::Wp_1(x) }
      Term::Wp_1(a) { apply(apply(x, a), a) }
    }
  }

  /// Evaluates a term in prefix form. A backtick applies the next two terms;
  /// a bird is written by its name, and a space ends a name. So
  /// `` ``S K K `` is `S K K`. An unknown name, or the end of the input,
  /// reads as `I`.
  pub fn eval(src: String) -> Term {
    let chars = src as List[Char];
    eval_from(&chars)
  }

  fn eval_from(&chars: &List[Char]) -> Term {
    let name = [];
    while chars.pop_front() is Option::Some(c) {
      if c == '`' {
        let f = eval_from(&chars);
        let x = eval_from(&chars);
        return apply(f, x);
      }
      if c == ' ' {
        if name.len() != 0 {
          break;
        }
      } else {
        name.push_back(c);
      }
    }
    bird(name as String)
  }

  /// The bird with the given name, or `I`.
  pub fn bird(name: String) -> Term {
    when {
      name == "B" { Term::B_0() }
      name == "B1" { Term::B1_0() }
      name == "B2" { Term::B2_0() }
      name == "B3" { Term::B3_0() }
      name == "C" { Term::C_0() }
      name == "C*" { Term::Cs_0() }
      name == "C**" { Term::Css_0() }
      name == "D" { Term::D_0() }
      name == "D1" { Term::D1_0() }
      name == "D2" { Term::D2_0() }
      name == "E" { Term::E_0() }
      name == "Ê" { Term::Eh_0() }
      name == "F" { Term::F_0() }
      name == "F*" { Term::Fs_0() }
      name == "F**" { Term::Fss_0() }
      name == "G" { Term::G_0() }
      name == "H" { Term::H_0() }
      name == "I" { Term::I_0() }
      name == "I*" { Term::Is_0() }
      name == "I**" { Term::Iss_0() }
      name == "J" { Term::J_0() }
      name == "K" { Term::K_0() }
      name == "Ki" { Term::Ki_0() }
      name == "KM" { Term::KM_0() }
      name == "KM'" { Term::KMp_0() }
      name == "L" { Term::L_0() }
      name == "M" { Term::M_0() }
      name == "M2" { Term::M2_0() }
      name == "O" { Term::O_0() }
      name == "Φ" { Term::Phi_0() }
      name == "Ψ" { Term::Psi_0() }
      name == "Q" { Term::Q_0() }
      name == "Q1" { Term::Q1_0() }
      name == "Q2" { Term::Q2_0() }
      name == "Q3" { Term::Q3_0() }
      name == "Q4" { Term::Q4_0() }
      name == "R" { Term::R_0() }
      name == "R*" { Term::Rs_0() }
      name == "R**" { Term::Rss_0() }
      name == "S" { Term::S_0() }
      name == "T" { Term::T_0() }
      name == "U" { Term::U_0() }
      name == "V" { Term::V_0() }
      name == "V*" { Term::Vs_0() }
      name == "V**" { Term::Vss_0() }
      name == "W" { Term::W_0() }
      name == "W*" { Term::Ws_0() }
      name == "W**" { Term::Wss_0() }
      name == "W'" { Term::Wp_0() }
      _ { Term::I_0() }
    }
  }

  /// The term in prefix form.
  pub fn .prefix(self: Term) -> String {
    let out = [];
    self.write(&out);
    out as String
  }

